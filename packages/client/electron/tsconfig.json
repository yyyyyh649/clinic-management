{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "../dist-electron",
    "rootDir": "."
  },
  "include": ["./**/*.ts"],
  "exclude": ["../node_modules", "../dist-renderer", "./preload.ts"]
}
