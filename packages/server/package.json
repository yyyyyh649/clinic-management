{
  "name": "@clinic/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build": "tsc -p tsconfig.json && npm run build:web",
    "start": "node dist/index.js",
    "db:push": "DATABASE_URL=file:./server.db prisma db push --schema=../shared/prisma/schema.prisma --accept-data-loss",
    "seed": "tsx src/seed-loader.ts"
  },
  "dependencies": {
    "@clinic/shared": "*",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "@vitejs/plugin-react": "^4.3.3"
  }
}
