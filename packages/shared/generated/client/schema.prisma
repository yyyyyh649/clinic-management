// Prisma schema for the eye-clinic chain customer management system.
// One schema, two deployments:
//   - Cloud server (server.db)      : authoritative store, multi-device merge target.
//   - Each Electron front-desk device (client.db): full local cache, offline-first.
// Money is stored as Int CENTS to avoid floating-point drift. Beans / points are Int counts.
// 100 豆 = 1 元 = 100 分, so 1 豆 == 1 分 numerically (convenient for FIFO/award math).

generator client {
  provider   = "prisma-client-js"
  output     = "../generated/client"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Enum-like string constants (kept as String for SQLite simplicity) ----------
// Dept: "OPTICAL" | "EYE"
// Ledger.field: "BALANCE" | "BEANS" | "POINTS"
// Ledger.source: "RECHARGE" | "CONSUME" | "AWARD" | "EXPIRE" | "ADJUST" | "INIT"
// Payment.discountType: "PERCENT" | "MINUS"
// Member.status: "ACTIVE" | "DELETED"
// ReviewStatus: "PENDING" | "CONTACTED" | "CONTACTED_NO_SHOW" | "REVIEWED"
// SyncState: "PENDING" | "SYNCED"

// ---------- Store / Device ----------

model Store {
  id        String    @id @default(uuid())
  code      String    @unique // short code like "S1"
  name      String // 部署时填写的门店名
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  devices Device[]
}

model Device {
  id          String    @id @default(uuid())
  deviceCode  String    @unique // short code, part of record-id prefix when needed
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  displayName String?
  boundAt     DateTime  @default(now())
  lastSyncAt  DateTime?
  appVersion  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Staff (operator / registrar; cross-dept, cross-store) ----------

model Staff {
  id       String  @id @default(uuid())
  name     String
  code     String  @unique // 工号/简称
  // departments joined by ",", e.g. "OPTICAL,EYE"
  depts    String  @default("OPTICAL")
  // operator may also be a member (豆/积分归属默认本人)
  isMember Boolean @default(false)
  memberId String? @unique
  phone    String?
  active   Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([name])
}

// ---------- Customer (base entity, permanent; member is an extension) ----------

model Customer {
  id       String    @id @default(uuid()) // customer_id, never changes
  name     String
  phone    String // current phone (mutable)
  address  String?
  birthday DateTime?
  gender   String?

  isMember Boolean @default(false)
  memberId String? @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // provenance
  createdByStaffId  String?
  createdByStoreId  String?
  createdByDeviceId String?

  member       Member?
  phoneHistory PhoneHistory[]
  exams        ExamRecord[]

  @@index([phone])
  @@index([name])
  @@index([memberId])
}

model PhoneHistory {
  id            String   @id @default(uuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  oldPhone      String
  newPhone      String
  changedAt     DateTime @default(now())
  changedBy     String // staff id
  changedByName String
  storeId       String?
  reason        String?

  @@index([customerId])
  @@index([oldPhone])
}

// ---------- Tier rules (config, max 20) ----------

model TierRule {
  id           String  @id @default(uuid())
  level        Int     @unique // 1 (lowest) .. 20
  name         String // 档位名
  minPoints    Int // 累计积分门槛
  // 累计积分清零周期 (only affects POINTS, not beans)
  clearEnabled Boolean @default(false)
  clearPeriod  String? // "YEAR" | "MONTH" | null
  clearMonth   Int? // 1..12 (when YEAR)
  clearDay     Int? // day of month
  sortOrder    Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Bean expiry setting (global) ----------
// 不设置 => 永久有效. 设置 => 每笔新产生的豆按获得时间+有效期算到期日, 到期核销.

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ---------- Member (extension of customer) ----------

model Member {
  id         String    @id @default(uuid()) // member_id
  customerId String    @unique
  customer   Customer  @relation(fields: [customerId], references: [id])
  cardNo     String    @unique
  status     String    @default("ACTIVE") // ACTIVE | DELETED
  deletedAt  DateTime?

  registeredBy        String // staff id
  registeredByName    String
  registeredStoreId   String
  registeredStoreName String
  registeredAt        DateTime @default(now())

  // provenance / sync
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ledgers     Ledger[]
  beanBatches BeanBatch[]
  recharges   Recharge[]

  @@index([cardNo])
  @@index([status])
}

// ---------- Ledger: append-only source of truth for balance / beans / points ----------
// current value = SUM(delta) WHERE memberId = X AND field = Y AND (consumedAt IS NULL for bean expiry? no—bean batches track that)

model Ledger {
  id          String  @id @default(uuid()) // UUID global unique (multi-device safe)
  memberId    String
  member      Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  field       String // "BALANCE" | "BEANS" | "POINTS"
  delta       Int // signed delta in the field's unit (cents for BALANCE, count for BEANS/POINTS)
  source      String // "RECHARGE" | "CONSUME" | "AWARD" | "EXPIRE" | "ADJUST" | "INIT"
  reason      String // 备注 (required for manual edits)
  refType     String? // "PAYMENT" | "EXAM" | "RECHARGE" | "ADJUST" | "EXPIRE"
  refId       String?
  // bean batch linkage (for BEANS positive awards that expire)
  beanBatchId String?

  operatorId       String
  operatorName     String
  operatorMemberId String? // when operator is a member
  storeId          String
  storeName        String
  deviceId         String

  createdAt DateTime @default(now())

  // sync
  syncStatus String    @default("PENDING") // PENDING | SYNCED
  syncedAt   DateTime?
  origin     String    @default("CLIENT") // "CLIENT" | "SERVER"

  @@index([memberId, field])
  @@index([createdAt])
  @@index([syncStatus])
  @@index([beanBatchId])
}

// ---------- Bean batches (for FIFO expiry consumption) ----------
// Each positive bean award creates a batch with remaining count and expiresAt.
// Consuming beans decrements the earliest-expiring non-empty batch first (FIFO).

model BeanBatch {
  id        String    @id @default(uuid()) // batchId, referenced by Ledger.beanBatchId
  memberId  String
  member    Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  remaining Int // remaining beans in this batch (decremented on consume)
  total     Int // original award amount (for audit)
  expiresAt DateTime? // null => never expires
  source    String // "AWARD" | "RECHARGE_GIFT" | "INIT"
  refId     String? // payment / recharge id
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expired   Boolean   @default(false)

  @@index([memberId, expiresAt])
}

// ---------- Exam record ----------

model ExamRecord {
  id           String   @id @default(uuid()) // exam_id
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id])
  dept         String // "OPTICAL" | "EYE"
  templateId   String?
  templateName String?
  content      String? // JSON string of structured template answers (nullable if no template)

  // OPTICAL
  lensBrand  String?
  lensPrice  Int? // cents
  frameBrand String?
  framePrice Int? // cents

  // EYE
  totalAmount Int? // cents

  baseAmount Int @default(0) // computed base amount in cents

  // review
  reviewDate   DateTime // next review date (default +90d, editable)
  reviewerId   String?
  reviewerName String?
  reviewStatus String   @default("PENDING") // PENDING | CONTACTED | CONTACTED_NO_SHOW | REVIEWED
  reviewNote   String?

  registeredBy        String
  registeredByName    String
  registeredStoreId   String
  registeredStoreName String
  registeredDeviceId  String
  registeredAt        DateTime @default(now())

  payment   Payment?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([customerId])
  @@index([reviewStatus])
  @@index([reviewDate])
  @@index([registeredStoreId])
  @@index([dept])
}

// ---------- Payment ----------

model Payment {
  id     String     @id @default(uuid())
  examId String     @unique
  exam   ExamRecord @relation(fields: [examId], references: [id])

  baseAmount    Int // 应付基础 = lens+frame or eye total (cents)
  discountType  String? // "PERCENT" | "MINUS"
  discountValue Int? // 85 => 85折; 5000 => 立减50元(5000分)
  afterDiscount Int // 折后应付 (cents)

  balanceDeduct     Int     @default(0) // 卡内余额抵扣 (cents)
  beansDeduct       Int     @default(0) // 豆抵扣数量 (must be multiple of 100)
  beansDeductAmount Int     @default(0) // 豆抵扣金额 (cents) == beansDeduct (1豆=1分)
  cashPaid          Int // 实付现金 (cents)
  cashPaidEdited    Boolean @default(false)
  editReason        String? // required if cashPaidEdited

  beansAwarded  Int @default(0) // 现金支付获得的豆 (manual editable, no reason needed)
  pointsAwarded Int @default(0) // 同步写进累计积分 (manual editable)

  // 代付: when paid using another member's balance/beans
  payForMemberId     String? // the member whose balance/beans were used (代付对象)
  payForMemberName   String?
  payForMemberCardNo String?
  // beneficiary of beans/points award (归属)
  awardMemberId      String? // default = operator's own member, or designated
  awardMemberName    String?

  operatorId   String
  operatorName String
  storeId      String
  storeName    String
  deviceId     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([examId])
  @@index([payForMemberId])
  @@index([awardMemberId])
  @@index([createdAt])
}

// ---------- Recharge (充值): tracks cash received vs balance/beans added ----------

model Recharge {
  id       String @id @default(uuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id])
  cardNo   String

  cashPaid     Int // actual cash received (cents) -> 现金池
  balanceAdded Int // balance added to card (cents) -> 储值池 (>= cashPaid if bonus)
  beansGifted  Int     @default(0) // beans given as gift on recharge
  pointsGifted Int     @default(0) // points given as gift (rare)
  note         String?

  operatorId   String
  operatorName String
  storeId      String
  storeName    String
  deviceId     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([memberId])
  @@index([createdAt])
  @@index([storeId])
}

// ---------- Exam templates (max 10 per dept type) ----------

model ExamTemplate {
  id       String  @id @default(uuid())
  name     String
  dept     String // "OPTICAL" | "EYE"
  // JSON: array of pages -> array of questions { id, type: CHOICE|FILL, title, required, options:[], other:true }
  pages    String // JSON string
  isActive Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([dept])
}

// ---------- Brands (lens / frame), chain-wide shared ----------

model Brand {
  id        String  @id @default(uuid())
  name      String
  type      String // "LENS" | "FRAME"
  sortIndex Int     @default(0)
  active    Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([type])
}

// ---------- Anomaly review (断网合并后余额/豆为负) ----------

model AnomalyRecord {
  id                String  @id @default(uuid())
  memberId          String
  memberName        String?
  memberCardNo      String?
  field             String // "BALANCE" | "BEANS"
  currentValue      Int // the negative computed value
  status            String  @default("OPEN") // OPEN | RESOLVED
  conflictLedgerIds String // JSON array of ledger ids
  detail            String // human-readable summary
  storeId           String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  resolvedAt     DateTime?
  resolvedBy     String?
  resolvedByName String?
  resolveNote    String?

  @@index([status])
  @@index([memberId])
}

// ---------- Recycle bin (soft-delete tracking, 30-day retention) ----------

model RecycleBinEntry {
  id              String   @id @default(uuid())
  entityType      String // "CUSTOMER" | "MEMBER" | "EXAM" | ...
  entityId        String
  entitySnapshot  String // JSON snapshot of the deleted record
  deletedAt       DateTime @default(now())
  deletedBy       String
  deletedByName   String
  sourceStoreId   String?
  sourceStoreName String?
  // cannot be re-deleted within 30 days (enforced in code)

  @@index([entityType])
  @@index([deletedAt])
}

// ---------- Audit log ----------

model AuditLog {
  id           String   @id @default(uuid())
  action       String // "CREATE" | "UPDATE" | "DELETE" | "LOGIN" | "ADJUST"
  entityType   String
  entityId     String?
  details      String // JSON
  operatorId   String?
  operatorName String?
  storeId      String?
  deviceId     String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([entityType])
  @@index([action])
}

// ---------- Sync cursors (per device per table, for pull) ----------

model SyncCursor {
  id         String   @id @default(uuid())
  deviceId   String
  tableName  String
  lastCursor DateTime // last createdAt seen

  @@unique([deviceId, tableName])
}
